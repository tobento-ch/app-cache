{
    "name": "tobento/app-cache",
    "version": "2.0",
    "type": "library",
    "description": "App cache support.",
    "keywords": [
        "tobento",
        "package",
        "app",
        "cache"
    ],
    "homepage": "https://www.tobento.ch",
    "license": "MIT",
    "authors": [
        {
            "name": "Tobias Strub",
            "email": "info@tobento.ch",
            "homepage": "https://www.tobento.ch"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "tobento/app": "^2.0",
        "tobento/app-migration": "^2.0",
        "tobento/app-file-storage": "^2.0",
        "tobento/service-cache": "^2.0",
        "tobento/service-clock": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.3",
        "vimeo/psalm": "^6.13",
        "tobento/app-console": "^2.0",
        "tobento/service-filesystem": "^2.0",
        "tobento/service-file-storage": "^2.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "Tobento\\App\\Cache\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tobento\\App\\Cache\\Test\\": "tests",
            "Tobento\\Service\\Console\\Test\\": "vendor/tobento/service-console/tests"
        }
    },
    "scripts": {
        "test": "phpunit --testdox --colors=always",
        "psalm": "vendor/bin/psalm"
    }
}